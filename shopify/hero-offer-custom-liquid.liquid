{%- comment -%}
  ===========================================================================
  HERO OFFER BLOCK — paste into a "Custom Liquid" section/block in Shopify.
  Fully self-contained: all styles are scoped under .plh so nothing in your
  theme leaks in or out. Fluid sizing via clamp() — no media-query surgery
  needed for phone / tablet / desktop.

  EDIT ME: the settings block right below. Everything else is layout.
  ===========================================================================
{%- endcomment -%}

{%- liquid
  # ---------- EDITABLE SETTINGS ----------
  assign badge_text     = 'Limited stock — schools are ordering 20+ at a time'
  assign rating_value   = '4.9'
  assign rating_count   = '2,847'
  assign price_text     = '$39.90'
  assign compare_text   = '$79.80'
  assign discount_text  = '50% OFF'
  assign save_text      = '$39.90'
  assign save_suffix    = 'today only'
  assign flash_text     = 'Flash sale — prices increase in 4 hours'

  # Benefits: separate each line with a pipe |
  assign benefits = 'Rewires curiosity into a lifelong learning habit|Boosts school performance, vocabulary & memory|Competes with screens — kids choose it over YouTube|Perfect for ages 6–12, gift-ready hardcover packaging'
  assign benefit_list = benefits | split: '|'

  # ---------- OPTIONAL: use the REAL product price ----------
  # Liquid strings can't contain escaped quotes, so the headline is set with
  # a capture tag just below instead of an assign.
  #
  # On a product page, delete the leading "# " from the 10 lines below and the
  # live variant price overrides the hardcoded values above.
  #
  # if product
  #   assign v = product.selected_or_first_available_variant
  #   assign price_text = v.price | money
  #   assign compare_text = ''
  #   assign discount_text = ''
  #   assign save_text = ''
  #   if v.compare_at_price > v.price
  #     assign saved = v.compare_at_price | minus: v.price
  #     assign compare_text = v.compare_at_price | money
  #     assign save_text = saved | money
  #     assign pct = saved | times: 100.0 | divided_by: v.compare_at_price | round
  #     assign discount_text = pct | append: '% OFF'
  #   endif
  # endif
-%}

{%- capture heading -%}
  Kid's Encyclopedia "10,000 Whys" — Unlock Your Child's Full Potential
{%- endcapture -%}

{%- comment -%}
  ---------- REVIEW CAROUSEL CONTENT ----------
  One review per block, fields separated by ~~ and reviews separated by ||
      quote ~~ name ~~ role ~~ avatar image URL

  Avatar: upload the photo in Shopify admin → Settings → Files, copy its URL
  and paste it as the 4th field. Leave the field empty for an initial circle.
{%- endcomment -%}

{%- capture review_data -%}
  Best money I've spent on my kids' education outside of school. The conversations it starts are priceless.
  ~~ Jennifer L. ~~ Mom of three ~~
  ||
  He used to beg for the tablet after dinner. Now he brings me this book and asks me to look things up with him.
  ~~ Marcus T. ~~ Dad of two ~~
  ||
  I ordered a set for my whole class. The kids fight over who gets to read it at break time.
  ~~ Priya R. ~~ Grade 4 teacher ~~
{%- endcapture -%}

{%- liquid
  assign review_rows = review_data | split: '||'
  # Milliseconds between slides. Set to 0 to turn autoplay off.
  assign review_autoplay = 6000
-%}

<div class="plh">
  <div class="plh__inner">

    <div class="plh__badge">
      <span class="plh__dot" aria-hidden="true"></span>
      <span>{{ badge_text }}</span>
    </div>

    <h1 class="plh__title">{{ heading | strip }}</h1>

    <div class="plh__rating">
      <span class="plh__stars" aria-hidden="true">★★★★★</span>
      <span class="plh__rating-num">{{ rating_value }}</span>
      <span class="plh__rating-sep">·</span>
      <span class="plh__rating-count">{{ rating_count }} reviews</span>
    </div>

    <div class="plh__price-row">
      <span class="plh__price">{{ price_text }}</span>
      {%- if compare_text != blank -%}
        <s class="plh__compare">{{ compare_text }}</s>
      {%- endif -%}
      {%- if discount_text != blank -%}
        <span class="plh__discount">{{ discount_text }}</span>
      {%- endif -%}
    </div>

    {%- if save_text != blank -%}
      <p class="plh__save">
        <span class="plh__save-emoji" aria-hidden="true">🎉</span>
        You save <strong>{{ save_text }}</strong> <span class="plh__save-suffix">{{ save_suffix }}</span>
      </p>
    {%- endif -%}

    <ul class="plh__benefits">
      {%- for benefit in benefit_list -%}
        <li class="plh__benefit">
          <span class="plh__check" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" width="13" height="13">
              <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.6"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="plh__benefit-text">{{ benefit | strip }}</span>
        </li>
      {%- endfor -%}
    </ul>

    <div class="plh__flash">
      <span class="plh__flash-rule" aria-hidden="true"></span>
      <span class="plh__flash-text"><span aria-hidden="true">⚡</span> {{ flash_text }}</span>
      <span class="plh__flash-rule" aria-hidden="true"></span>
    </div>

    {%- if review_rows.size > 0 -%}
      <div class="plh-rev" data-autoplay="{{ review_autoplay }}">
        <div class="plh-rev__track">
          {%- for row in review_rows -%}
            {%- assign f = row | split: '~~' -%}
            {%- assign r_quote  = f[0] | strip -%}
            {%- assign r_name   = f[1] | strip -%}
            {%- assign r_role   = f[2] | strip -%}
            {%- assign r_avatar = f[3] | strip -%}
            <figure class="plh-rev__slide">
              <blockquote class="plh-rev__quote">&ldquo;{{ r_quote }}&rdquo;</blockquote>
              <figcaption class="plh-rev__who">
                {%- if r_avatar != blank -%}
                  <img class="plh-rev__avatar" src="{{ r_avatar }}" alt="{{ r_name }}"
                       width="104" height="104" loading="lazy">
                {%- else -%}
                  <span class="plh-rev__avatar plh-rev__avatar--initial" aria-hidden="true">
                    {{ r_name | slice: 0 }}
                  </span>
                {%- endif -%}
                <span class="plh-rev__meta">
                  <span class="plh-rev__name">{{ r_name }}</span>
                  <span class="plh-rev__sub">
                    <span class="plh-rev__role">{{ r_role }}</span>
                    <span class="plh-rev__sep" aria-hidden="true">·</span>
                    <span class="plh-rev__stars" aria-hidden="true">★★★★★</span>
                  </span>
                </span>
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>

        {%- if review_rows.size > 1 -%}
          <button class="plh-rev__nav plh-rev__nav--prev" type="button" aria-label="Previous review">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="plh-rev__nav plh-rev__nav--next" type="button" aria-label="Next review">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="plh-rev__dots">
            {%- for row in review_rows -%}
              <button class="plh-rev__dot" type="button"
                      aria-label="Go to review {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  .plh {
    /* ---- TWEAK THE LOOK HERE ---- */
    --plh-bg:        #ffffff;   /* surface — use transparent to blend fully */
    --plh-ink:       #101a35;   /* headline / body navy     */
    --plh-muted:     #6b7482;   /* review + compare-at grey */
    --plh-accent:    #b23a29;   /* price + sale red         */
    --plh-amber-bg:  #fdf4dc;   /* badge fill               */
    --plh-amber-br:  #f0c04a;   /* badge border             */
    --plh-amber-ink: #8a4b12;   /* badge text               */
    --plh-green-bg:  #dcf5e3;   /* check circle fill        */
    --plh-green-ink: #17864a;   /* check tick               */
    --plh-rule:      #e7ebf1;   /* hairline dividers        */
    --plh-star:      #f5a623;
    --plh-max:       860px;     /* content width            */

    /* Padding. Set --plh-pad-x to 0 if your theme's column already pads the
       block — that keeps this text flush with the rest of the column. */
    --plh-pad-x:     clamp(0px, 2.2cqi, 24px);
    --plh-pad-y:     clamp(16px, 4cqi, 40px);
    /* Bottom padding is 0 so nothing dangles above whatever follows the
       block. Raise it if this sits on its own as a full-width section. */
    --plh-pad-b:     0px;

    /* Sizes scale off THIS BOX's width (cqi), not the viewport, so the block
       looks right in a narrow product column and in a full-width section.
       Each rule ships a plain px fallback first for older browsers. */
    container-type: inline-size;

    background: var(--plh-bg);
    color: var(--plh-ink);
    font-family: inherit;
    padding: 24px 12px 0;
    padding: var(--plh-pad-y) var(--plh-pad-x) var(--plh-pad-b);
    -webkit-font-smoothing: antialiased;
  }
  .plh *,
  .plh *::before,
  .plh *::after { box-sizing: border-box; }

  /* Themes style bare blockquote/figure/button elements; neutralise that
     so the block looks the same on every theme. */
  .plh figure,
  .plh figcaption,
  .plh blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    quotes: none;
  }
  .plh blockquote::before,
  .plh blockquote::after { content: none; }
  .plh button {
    font: inherit;
    -webkit-appearance: none;
    appearance: none;
  }

  .plh__inner { max-width: var(--plh-max); margin: 0 auto; }

  /* ---------- badge ---------- */
  .plh__badge {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--plh-amber-bg);
    border: 2px solid var(--plh-amber-br);
    color: var(--plh-amber-ink);
    border-radius: 999px;
    padding: 9px 15px;
    padding: clamp(8px, 1.8cqi, 13px) clamp(13px, 3cqi, 20px);
    font-size: 13px;
    font-size: clamp(11.5px, 2.6cqi, 16px);
    font-weight: 700;
    line-height: 1.3;
  }
  .plh__dot {
    flex: 0 0 auto;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--plh-accent);
    box-shadow: 0 0 0 3px rgba(178, 58, 41, .15);
  }

  /* ---------- headline ---------- */
  .plh__title {
    margin: 16px 0 0;
    margin: clamp(14px, 3.2cqi, 28px) 0 0;
    font-size: 30px;
    font-size: clamp(24px, 6.3cqi, 50px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--plh-ink);
    overflow-wrap: break-word;
  }

  /* ---------- rating ---------- */
  .plh__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
    margin-top: clamp(10px, 2.2cqi, 18px);
    font-size: 14px;
    font-size: clamp(12.5px, 2.9cqi, 18px);
  }
  .plh__stars {
    color: var(--plh-star);
    font-size: 16px;
    font-size: clamp(14px, 3.4cqi, 24px);
    letter-spacing: 1px;
    line-height: 1;
  }
  .plh__rating-num   { font-weight: 700; }
  .plh__rating-sep,
  .plh__rating-count { color: var(--plh-muted); font-weight: 600; }

  /* ---------- price ---------- */
  .plh__price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    gap: clamp(8px, 2.2cqi, 18px);
    margin-top: 14px;
    margin-top: clamp(12px, 2.8cqi, 26px);
  }
  .plh__price {
    font-size: 38px;
    font-size: clamp(30px, 8cqi, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--plh-accent);
  }
  .plh__compare {
    font-size: 21px;
    font-size: clamp(17px, 4.3cqi, 30px);
    font-weight: 700;
    color: var(--plh-muted);
    text-decoration-thickness: 2px;
  }
  .plh__discount {
    background: var(--plh-accent);
    color: #fff;
    border-radius: 9px;
    padding: 7px 11px;
    padding: clamp(6px, 1.5cqi, 11px) clamp(9px, 2.2cqi, 16px);
    font-size: 13px;
    font-size: clamp(11.5px, 2.7cqi, 18px);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  /* ---------- you save ---------- */
  .plh__save {
    margin: 10px 0 0;
    margin: clamp(9px, 2cqi, 16px) 0 0;
    font-size: 14px;
    font-size: clamp(12.5px, 2.9cqi, 18px);
    color: var(--plh-muted);
    font-weight: 500;
  }
  .plh__save strong { color: var(--plh-ink); font-weight: 800; }
  .plh__save-emoji  { margin-right: 4px; }
  .plh__save-suffix { color: var(--plh-muted); }

  /* ---------- benefits ---------- */
  .plh__benefits {
    list-style: none;
    margin: 18px 0 0;
    margin: clamp(16px, 3.6cqi, 34px) 0 0;
    padding: 0;
    border-top: 1px solid var(--plh-rule);
  }
  .plh__benefit {
    display: flex;
    align-items: center;
    gap: 11px;
    gap: clamp(10px, 2.4cqi, 18px);
    padding: 11px 0;
    padding: clamp(9px, 2.2cqi, 20px) 0;
    border-bottom: 1px solid var(--plh-rule);
  }
  .plh__check {
    flex: 0 0 auto;
    width: 23px;  height: 23px;
    width: clamp(21px, 4.6cqi, 34px);
    height: clamp(21px, 4.6cqi, 34px);
    border-radius: 50%;
    background: var(--plh-green-bg);
    color: var(--plh-green-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .plh__check svg { width: 56%; height: 56%; display: block; }
  .plh__benefit-text {
    font-size: 15px;
    font-size: clamp(13.5px, 3.2cqi, 21px);
    line-height: 1.35;
    font-weight: 500;
  }

  /* ---------- flash sale ---------- */
  .plh__flash {
    display: flex;
    align-items: center;
    gap: 10px;
    gap: clamp(8px, 2.2cqi, 18px);
    margin-top: 18px;
    margin-top: clamp(16px, 3.2cqi, 30px);
  }
  .plh__flash-rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--plh-rule);
  }
  .plh__flash-text {
    flex: 0 1 auto;
    text-align: center;
    font-size: 11.5px;
    font-size: clamp(10.5px, 2.35cqi, 16px);
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--plh-ink);
  }
  /* ---------- review (inline pull-quote, not a card) ---------- */
  .plh-rev {
    position: relative;
    margin-top: 16px;
    margin-top: var(--plh-rev-gap, clamp(14px, 3.2cqi, 24px));
    padding-left: 14px;
    padding-left: clamp(12px, 2.6cqi, 18px);
    border-left: 3px solid var(--plh-amber-br);
  }

  /* slides stack in one grid cell: height = tallest review, no jumping */
  .plh-rev__track { display: grid; }
  .plh-rev__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity .3s ease;
  }
  .plh-rev__slide:first-child,
  .plh-rev__slide.is-on { opacity: 1; visibility: visible; }
  .plh-rev[data-plh-ready] .plh-rev__slide:first-child:not(.is-on) {
    opacity: 0;
    visibility: hidden;
  }

  .plh-rev__quote {
    font-size: 14px;
    font-size: clamp(13px, 2.75cqi, 17px);
    line-height: 1.5;
    font-style: italic;
    font-weight: 500;
    color: var(--plh-ink);
  }
  /* right padding keeps the author clear of the controls */
  .plh-rev__who {
    display: flex;
    align-items: center;
    gap: 9px;
    gap: clamp(8px, 2cqi, 12px);
    margin-top: 10px;
    margin-top: clamp(9px, 2cqi, 14px);
    padding-right: 100px;
  }
  .plh-rev__avatar {
    flex: 0 0 auto;
    width: 32px;  height: 32px;
    width: clamp(28px, 6.4cqi, 40px);
    height: clamp(28px, 6.4cqi, 40px);
    border-radius: 50%;
    object-fit: cover;
    background: #eef1f6;
  }
  .plh-rev__avatar--initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-size: clamp(12.5px, 2.9cqi, 18px);
    font-weight: 800;
    color: var(--plh-ink);
    text-transform: uppercase;
  }
  .plh-rev__meta { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .plh-rev__name {
    font-size: 13.5px;
    font-size: clamp(12.5px, 2.7cqi, 16px);
    font-weight: 800;
    color: var(--plh-ink);
    line-height: 1.25;
  }
  .plh-rev__sub {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    font-size: 12px;
    font-size: clamp(11.5px, 2.4cqi, 14px);
    color: var(--plh-muted);
    font-weight: 500;
    line-height: 1.25;
  }
  .plh-rev__stars { color: var(--plh-star); letter-spacing: .5px; }

  /* controls sit on the author row, right-aligned: arrow centre lines up
     with the avatar centre, whatever the container width */
  .plh-rev__nav {
    position: absolute;
    bottom: calc((clamp(28px, 6.4cqi, 40px) - clamp(24px, 5.2cqi, 30px)) / 2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;  height: 26px;
    width: clamp(24px, 5.2cqi, 30px);
    height: clamp(24px, 5.2cqi, 30px);
    padding: 0;
    border: 1.5px solid var(--plh-ink);
    border-radius: 50%;
    background: transparent;
    color: var(--plh-ink);
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
  }
  .plh-rev__nav svg { width: 52%; height: 52%; }
  .plh-rev__nav:hover { background: var(--plh-ink); color: #fff; }
  .plh-rev__nav:focus-visible { outline: 2px solid var(--plh-accent); outline-offset: 2px; }
  .plh-rev__nav--next { right: 0; }
  .plh-rev__nav--prev { right: calc(clamp(24px, 5.2cqi, 30px) + 6px); }

  .plh-rev__dots {
    position: absolute;
    bottom: calc((clamp(28px, 6.4cqi, 40px) / 2) - 3px);
    right: calc((clamp(24px, 5.2cqi, 30px) * 2) + 18px);
    display: flex;
    gap: 5px;
  }
  .plh-rev__dot {
    width: 6px; height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #d6dce6;
    cursor: pointer;
    transition: background .18s ease;
  }
  .plh-rev__dot.is-on { background: var(--plh-ink); }
  .plh-rev__dot:focus-visible { outline: 2px solid var(--plh-accent); outline-offset: 2px; }

  /* narrow columns: drop the dots, keep arrows and swipe */
  @container (max-width: 400px) {
    .plh-rev__dots { display: none; }
    .plh-rev__who  { padding-right: 62px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plh-rev__slide { transition: none; }
  }
</style>

<script>
  (function () {
    var roots = document.querySelectorAll('.plh-rev:not([data-plh-ready])');

    Array.prototype.forEach.call(roots, function (root) {
      root.setAttribute('data-plh-ready', '');

      var slides = root.querySelectorAll('.plh-rev__slide');
      var dots   = root.querySelectorAll('.plh-rev__dot');
      var delay  = parseInt(root.getAttribute('data-autoplay'), 10) || 0;
      var calm   = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var i = 0, timer = null;

      function show(n) {
        i = (n + slides.length) % slides.length;
        for (var s = 0; s < slides.length; s++) {
          var on = (s === i);
          slides[s].classList.toggle('is-on', on);
          slides[s].setAttribute('aria-hidden', on ? 'false' : 'true');
          if (dots[s]) dots[s].classList.toggle('is-on', on);
        }
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() {
        stop();
        if (delay > 0 && slides.length > 1 && !calm) {
          timer = setInterval(function () { show(i + 1); }, delay);
        }
      }
      function go(n) { show(n); start(); }

      var prev = root.querySelector('.plh-rev__nav--prev');
      var next = root.querySelector('.plh-rev__nav--next');
      if (prev) prev.addEventListener('click', function () { go(i - 1); });
      if (next) next.addEventListener('click', function () { go(i + 1); });

      Array.prototype.forEach.call(dots, function (dot, index) {
        dot.addEventListener('click', function () { go(index); });
      });

      // swipe
      var x0 = null;
      root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1);
        x0 = null;
      }, { passive: true });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show(0);
      start();
    });
  })();
</script>
